# ===================================================================
# Antigravity Comic Chronology Finder & Downloader - Configuration
# ===================================================================

# 1. Antigravity API Key
# Paste your new API key below. Supports either:
#   - Antigravity Enterprise Gateway key (e.g., agy_app_...)
#   - Google Gemini API key (e.g., AIzaSy...)
ANTIGRAVITY_APP_KEY=your_antigravity_api_key_here

# 2. Antigravity Enterprise Gateway Endpoint (Optional)
# Default local gateway daemon address:
ANTIGRAVITY_GATEWAY_URL=http://127.0.0.1:8000

# 3. AI Model Selection (Optional)
# Recommended: gemini-2.5-flash, gemini-2.5-pro
ANTIGRAVITY_MODEL=gemini-2.5-flash
