# ===================================================================
# Antigravity Comic Chronology Finder & Downloader - Configuration
# ===================================================================

# 1. Antigravity Safe Keyless Virtual Middleware Endpoint (Zero Client Keys)
# Connect to your local or remote Antigravity Server without storing secret keys.
# The 128-bit public slug handles authorization securely via the URL path.
ANTIGRAVITY_ENDPOINT=http://127.0.0.1:8000/p/pub_b93935784aff3f67d55d904e7e43f30f/v1

# 2. AI Model Selection
ANTIGRAVITY_MODEL=gemini-2.5-flash

# 3. Mode C: Zero-Clutter / Stateless ("Ephemeral") Mode
# Set to 'true' (default) so comic queries auto-delete from AGY brain storage immediately
# and do not pollute your AGY chat history. Set to 'false' to preserve conversation sessions.
ANTIGRAVITY_EPHEMERAL=true

# 4. Optional: Cloudflare Public Tunnel Endpoint
# ANTIGRAVITY_ENDPOINT=https://<your-tunnel-domain>.trycloudflare.com/p/pub_b93935784aff3f67d55d904e7e43f30f/v1

# 5. Optional Legacy Fallback: Direct API Key (if not using Virtual Middleware)
# ANTIGRAVITY_APP_KEY=agy_app_...
# ANTIGRAVITY_GATEWAY_URL=http://127.0.0.1:8000
